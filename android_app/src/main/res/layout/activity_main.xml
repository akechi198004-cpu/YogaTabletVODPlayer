<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_main">

    <!-- Top App Bar -->
    <RelativeLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:background="@color/bg_elevated">

        <TextView
            android:id="@+id/app_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:text="HM 影视"
            android:textColor="@color/text_white"
            android:textSize="20sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_search"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_search_box"
            android:text=" 🔍 搜索影视 "
            android:textColor="@color/text_muted"
            android:textSize="12sp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:focusable="true" />
    </RelativeLayout>

    <!-- Main Content Frame -->
    <FrameLayout
        android:id="@+id/content_frame"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Bottom Navigation Bar -->
    <LinearLayout
        android:id="@+id/bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:orientation="horizontal"
        android:background="@color/bg_elevated"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/nav_btn_home"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="首页"
            android:textColor="@color/accent_cyan"
            android:textSize="14sp"
            android:textStyle="bold"
            android:focusable="true"
            android:padding="8dp"
            android:background="@drawable/bg_nav_item" />

        <TextView
            android:id="@+id/nav_btn_category"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="分类"
            android:textColor="@color/text_muted"
            android:textSize="14sp"
            android:focusable="true"
            android:padding="8dp"
            android:background="@drawable/bg_nav_item" />

        <TextView
            android:id="@+id/nav_btn_top"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="榜单"
            android:textColor="@color/text_muted"
            android:textSize="14sp"
            android:focusable="true"
            android:padding="8dp"
            android:background="@drawable/bg_nav_item" />

        <TextView
            android:id="@+id/nav_btn_daily"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="更新"
            android:textColor="@color/text_muted"
            android:textSize="14sp"
            android:focusable="true"
            android:padding="8dp"
            android:background="@drawable/bg_nav_item" />

        <TextView
            android:id="@+id/nav_btn_mine"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="收藏"
            android:textColor="@color/text_muted"
            android:textSize="14sp"
            android:focusable="true"
            android:padding="8dp"
            android:background="@drawable/bg_nav_item" />
    </LinearLayout>
</LinearLayout>
