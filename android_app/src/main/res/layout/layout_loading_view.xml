<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/loading_root_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="36dp"
    android:paddingBottom="36dp"
    android:background="@color/bg_main">

    <!-- Glowing Cyber Card Container -->
    <LinearLayout
        android:id="@+id/loading_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/bg_loading_card"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="28dp"
        android:paddingBottom="28dp">

        <!-- Engine Badge Pill -->
        <TextView
            android:id="@+id/loading_engine_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pill"
            android:text="HM影视 · 极速流媒体引擎"
            android:textColor="@color/accent_cyan"
            android:textSize="11sp"
            android:textStyle="bold"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:layout_marginBottom="20dp" />

        <!-- Circular Spinner with cyan tint -->
        <ProgressBar
            android:id="@+id/loading_spinner"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:indeterminate="true"
            android:layout_marginBottom="18dp" />

        <!-- Main Title Text -->
        <TextView
            android:id="@+id/loading_main_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="正在极速加载中…"
            android:textColor="@color/text_white"
            android:textSize="16sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="6dp" />

        <!-- Subtitle Info -->
        <TextView
            android:id="@+id/loading_sub_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="正在直连全球 CDN 节点 · 防盗链自动注入"
            android:textColor="@color/text_soft"
            android:textSize="12sp"
            android:gravity="center"
            android:layout_marginBottom="16dp" />

        <!-- Thin Horizontal Progress Accent Bar -->
        <ProgressBar
            android:id="@+id/loading_horizontal_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="96dp"
            android:layout_height="3dp"
            android:layout_gravity="center_horizontal"
            android:indeterminate="true"
            android:indeterminateTint="@color/accent_cyan"
            android:alpha="0.85"
            android:layout_marginBottom="14dp" />

        <!-- Bottom Fallback Note -->
        <TextView
            android:id="@+id/loading_bottom_tip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="若遇网络波动，系统将自动无缝切换备用线路"
            android:textColor="@color/text_muted"
            android:textSize="10sp"
            android:gravity="center" />

        <!-- Shown only when parsing failed and there is no playable source. -->
        <Button
            android:id="@+id/loading_back_button"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginTop="16dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/bg_pill"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:text="@string/player_back"
            android:textColor="@color/text_white"
            android:textSize="14sp"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
