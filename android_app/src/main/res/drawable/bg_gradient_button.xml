<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 电视遥控器聚焦状态 -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#526e91"
                android:endColor="#33465e"
                android:type="linear" />
            <stroke android:width="2.5dp" android:color="#ffffff" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#33465e"
                android:endColor="#263346"
                android:type="linear" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#3c526c"
                android:endColor="#293b51"
                android:type="linear" />
            <corners android:radius="24dp" />
        </shape>
    </item>
</selector>
