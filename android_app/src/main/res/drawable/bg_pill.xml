<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 电视遥控器聚焦状态 -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#263346" />
            <stroke android:width="2dp" android:color="@color/accent_cyan" />
            <corners android:radius="999dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#222d3b" />
            <stroke android:width="1.5dp" android:color="@color/accent_cyan" />
            <corners android:radius="999dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/bg_panel" />
            <stroke android:width="1dp" android:color="@color/border_subtle" />
            <corners android:radius="999dp" />
        </shape>
    </item>
</selector>
