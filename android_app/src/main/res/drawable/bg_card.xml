<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 电视遥控器聚焦高亮状态 (TV Remote Focus) -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#263346" />
            <stroke android:width="2.5dp" android:color="@color/accent_cyan" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <!-- 按下状态 (Pressed) -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#263346" />
            <stroke android:width="1.5dp" android:color="@color/accent_cyan" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <!-- 默认正常状态 (Default) -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/bg_elevated" />
            <stroke android:width="1dp" android:color="@color/border_subtle" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</selector>
